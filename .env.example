# Supabase Auth de la instancia compartida `shared-infra` (ver docs/adr/0003).
# Se consiguen en el panel de Coolify, recurso de shared-infra, o en Supabase
# Studio de esa instancia. Nunca commitear los valores reales.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres de shared-infra, apuntando al schema propio de este panel.
# El ?schema=enredado es lo que evita pisar los schemas de otros proyectos
# (tropero, sistemas, bertha) que viven en la misma base — ver ADR-0002/0003.
# Ejemplo de forma: postgres://usuario:password@db-shared.tropero.ar:5432/postgres?schema=enredado
DATABASE_URL=

# Origen público y estable del panel (con esquema, sin barra final), ej:
# https://cb53kbbqidm0ekr9ehha2hab.192.99.152.106.sslip.io
# Detrás del proxy de Coolify no se puede confiar en el Host que ve Next.js en
# las Route Handlers (termina viendo el bind interno del contenedor), así que
# las rutas de Meta arman sus redirects a partir de esta variable en vez de
# request.url — ver lib/meta/config.ts.
APP_URL=

# App de Meta for Developers, producto "Instagram API with Instagram Login"
# (Business Login for Instagram) — ver ADR-0001 y ADR-0012. Reemplaza a
# Facebook Login for Business (ADR-0008): Meta discontinuó los permisos que
# usaba ese flujo el 27/1/2025. Son credenciales propias de este producto,
# distintas del "Meta App ID" clásico. Los permisos van directo en el scope
# del login (lib/meta/oauth-url.ts), no en una Login Configuration. Las
# Cuentas de Instagram a conectar deben agregarse como Instagram Tester/Admin
# de esta App para no necesitar App Review.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Opcional, default v21.0 si se deja vacío. Sólo aplica al content publishing
# (graph.instagram.com/{version}/...) — el login/token de Instagram no lleva versión.
META_GRAPH_VERSION=

# Clave de 32 bytes en base64 para cifrar los tokens de Meta antes de
# guardarlos (ver ADR-0007). Generarla una vez con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# y no cambiarla después sin migrar los tokens ya guardados.
TOKEN_ENCRYPTION_KEY=

# Google Cloud (OAuth Client ID + API key) para el selector de Google Drive
# (Picker API, ticket 03). El Client ID y el API key son públicos (van al
# cliente) pero deben tener restricciones de dominio configuradas en Google
# Cloud Console — nunca dejarlos sin restringir.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=

# Supabase Storage de la misma instancia `shared-infra`, usado como
# exposición pública temporal para que Meta pueda descargar el archivo a
# publicar (se sube al momento de publicar, se borra apenas Meta confirma).
# El service role key es privado del servidor, nunca se expone al cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional, default "enredado-temp" si se deja vacío.
SUPABASE_STORAGE_BUCKET=

# Supabase Auth de la instancia compartida `shared-infra` (ver docs/adr/0003).
# Se consiguen en el panel de Coolify, recurso de shared-infra, o en Supabase
# Studio de esa instancia. Nunca commitear los valores reales.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres de shared-infra, apuntando al schema propio de este panel.
# El ?schema=enredado es lo que evita pisar los schemas de otros proyectos
# (tropero, sistemas, bertha) que viven en la misma base — ver ADR-0002/0003.
# Ejemplo de forma: postgres://usuario:password@db-shared.tropero.ar:5432/postgres?schema=enredado
DATABASE_URL=

# App de Meta for Developers (Facebook Login for Business + Instagram Graph API).
# Ver ADR-0001 y ADR-0008. Las Cuentas de Instagram a conectar deben agregarse
# como Instagram Tester/Admin de esta App para no necesitar App Review.
META_APP_ID=
META_APP_SECRET=
# Id de la Login Configuration creada en el dashboard de Meta (Facebook Login
# for Business → Configurations). Ahí se eligen los permisos (pages_show_list,
# pages_read_engagement, instagram_basic, instagram_content_publish), no en el
# código — ver ADR-0008.
META_LOGIN_CONFIG_ID=
# Opcional, default v21.0 si se deja vacío.
META_GRAPH_VERSION=

# Clave de 32 bytes en base64 para cifrar los tokens de Meta antes de
# guardarlos (ver ADR-0007). Generarla una vez con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# y no cambiarla después sin migrar los tokens ya guardados.
TOKEN_ENCRYPTION_KEY=

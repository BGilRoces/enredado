# Supabase Auth de la instancia compartida `shared-infra` (ver docs/adr/0003).
# Se consiguen en el panel de Coolify, recurso de shared-infra, o en Supabase
# Studio de esa instancia. Nunca commitear los valores reales.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres de shared-infra, apuntando al schema propio de este panel.
# El ?schema=enredado es lo que evita pisar los schemas de otros proyectos
# (tropero, sistemas, bertha) que viven en la misma base — ver ADR-0002/0003.
# Ejemplo de forma: postgres://usuario:password@db-shared.tropero.ar:5432/postgres?schema=enredado
DATABASE_URL=

// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── CUENTAS DE INSTAGRAM ───────────────────────────────────────────────────

enum EstadoCuenta {
  conectada
  desconectada
  // Meta rechazó la renovación del token (ej.: acceso revocado desde Meta).
  // Distinta de "desconectada": acá el dueño no la desconectó a propósito,
  // hay que reconectarla (ver ADR-0010 / ticket 07).
  necesitaReconexion
}

model Cuenta {
  id                     String        @id @default(cuid())
  nombre                 String
  igUserId               String        @unique
  igUsername             String
  // Token de acceso de Meta, cifrado con lib/crypto/token-cipher.ts antes de
  // llegar acá — nunca se guarda en texto plano (ver ADR-0007).
  accessTokenEncriptado  String?
  tokenExpiraEl          DateTime?
  estado                 EstadoCuenta  @default(conectada)
  creadaEn               DateTime      @default(now())
  actualizadaEn          DateTime      @updatedAt
  publicaciones          Publicacion[]
  ideas                  Idea[]
}

// ─── PUBLICACIONES ──────────────────────────────────────────────────────────

enum TipoPublicacion {
  post
  historia
  reel
}

enum EstadoPublicacion {
  pendiente
  publicando
  publicada
  fallida
  cancelada
  // La Cuenta ya llegó a su límite diario de Meta (ventana móvil de 24hs) —
  // nunca se intentó contra la Graph API, distinto de un fallo real (ticket 08).
  bloqueadaPorLimite
}

enum TipoMedia {
  imagen
  video
}

model Publicacion {
  id            String            @id @default(cuid())
  cuentaId      String
  cuenta        Cuenta            @relation(fields: [cuentaId], references: [id])
  tipo          TipoPublicacion
  // Nulo cuando la Publicación es un carousel (ver `archivos` abajo, y
  // ADR-0011): un carousel no tiene "el" archivo, tiene varios.
  driveFileId   String?
  // Drive lo exige para archivos compartidos por link (ver lib/drive/client.ts).
  // Sólo se usa en el paso "preparar" (ADR-0009/0015), nunca se re-lee después.
  driveResourceKey String?
  caption       String?
  // Nulo = publicar apenas la cola la procese. Con valor = Publicación
  // programada, el scheduler la deja lista para la cola recién al llegar la hora.
  programadaPara DateTime?
  // Se completan en el paso "preparar" (ver ADR-0009), antes de que la cola
  // la dispare — el archivo ya está expuesto en Storage cuando le toca salir.
  // Sólo aplican al caso simple (no carousel): ver `archivos`.
  tipoMedia     TipoMedia?
  storageUrl    String?
  estado        EstadoPublicacion @default(pendiente)
  metaMediaId   String?
  // Momento real en que Meta confirmó la publicación — no se infiere de
  // `actualizadaEn` (que se mueve con cualquier update a la fila) para que
  // el cálculo del límite diario (ticket 08) no dependa de una asunción
  // implícita sobre qué más puede llegar a tocar una fila "publicada".
  publicadaEn   DateTime?
  error         String?
  creadaEn      DateTime          @default(now())
  actualizadaEn DateTime          @updatedAt
  // Presente sólo en un carousel (Post con 2-10 elementos, ver ADR-0011) —
  // vacío en el caso simple, que sigue usando los campos de arriba.
  archivos      PublicacionArchivo[]
  // Presente sólo si esta Publicación nació de una Idea promocionada (ver
  // ADR-0013) — null en toda fila creada por /publicar. Es la señal que usa
  // el worker para decidir si tiene que preparar el archivo de forma lazy
  // (ADR-0015) en vez de esperar que ya venga preparado. No es único: una
  // Idea con una carpeta de Historias promociona a varias Publicaciones
  // independientes, una por archivo (ver ADR-0016).
  ideaId        String?
  idea          Idea?             @relation(fields: [ideaId], references: [id], onDelete: SetNull)
}

/**
 * Un elemento de un carousel (ver ADR-0011). Sólo existe para Publicaciones
 * de tipo Post con más de un archivo elegido — el caso simple (Historia,
 * Reel, Post de un solo archivo) sigue usando los campos de `Publicacion`
 * directamente, sin filas acá. `tipoMedia`/`storageUrl` nulos mientras el
 * archivo no fue preparado todavía — sólo pasa en el camino lazy de una Idea
 * con carpeta (ADR-0015/0016); el camino eager de /publicar los completa
 * siempre antes de crear la fila.
 */
model PublicacionArchivo {
  id               String      @id @default(cuid())
  publicacionId    String
  publicacion      Publicacion @relation(fields: [publicacionId], references: [id])
  orden            Int
  driveFileId      String
  driveResourceKey String?
  tipoMedia        TipoMedia?
  storageUrl       String?
  creadaEn         DateTime    @default(now())
}

// ─── IDEAS ───────────────────────────────────────────────────────────────

enum EstadoIdea {
  idea
  guionada
  grabada
  // El usuario pegó el link de Drive del archivo ya subido — ver ADR-0013.
  enDrive
}

/**
 * Notebook de ideas de contenido por Cuenta (ver ADR-0013). Es la fila
 * durable de todo el ciclo de vida — calendarizar (setear `programadaPara`)
 * no crea una fila aparte, y la Publicación real recién se crea cuando la
 * Idea es elegible para salir de verdad (enDrive + link + hora cumplida,
 * ver lib/ideas/decidir-ideas-para-promover.ts).
 */
model Idea {
  id               String          @id @default(cuid())
  cuentaId         String
  cuenta           Cuenta          @relation(fields: [cuentaId], references: [id])
  titulo           String
  descripcion      String?
  guion            String?
  linkReferencia1  String?
  linkReferencia2  String?
  tipo             TipoPublicacion
  // Texto real que sale en el post — separado de `guion` (notas de
  // producción) y `descripcion` (resumen interno de la idea).
  caption          String?
  estado           EstadoIdea      @default(idea)
  // Tal cual como lo pegó el usuario, para mostrarlo/reeditarlo.
  driveLink        String?
  // Parseados de driveLink (ver lib/ideas/parsear-drive-file-id.ts).
  driveFileId      String?
  driveResourceKey String?
  // Calendarizar = setear esto. Antes de `enDrive` es sólo un recordatorio,
  // nunca dispara nada (ver lib/ideas/decidir-ideas-para-promover.ts).
  programadaPara   DateTime?
  // Se completan recién al promocionar (ver ADR-0013) — de ahí en más el
  // estado real de publicación se lee de estas Publicaciones vinculadas, no
  // del `estado` de arriba. Puede ser más de una: una Idea con carpeta de
  // Historias promociona a N Publicaciones independientes (ver ADR-0016) —
  // Post con carpeta sigue siendo una sola (carousel).
  publicaciones    Publicacion[]
  // Presente sólo si driveLink apunta a una carpeta, no a un archivo puntual
  // (ver ADR-0016) — vacío en el caso simple, que sigue usando driveFileId/
  // driveResourceKey de arriba. El orden lo elige el usuario en el panel
  // (lib/ideas/parsear-drive-file-id.ts no puede inferirlo de Drive).
  archivos         IdeaArchivo[]
  creadaEn         DateTime        @default(now())
  actualizadaEn    DateTime        @updatedAt
}

/** Un archivo de la carpeta de Drive de una Idea (ver ADR-0016), con su orden elegido en el panel. */
model IdeaArchivo {
  id               String   @id @default(cuid())
  ideaId           String
  idea             Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  orden            Int
  driveFileId      String
  driveResourceKey String?
  // Sólo para mostrar en la UI de reordenar — Drive no expone bien el id solo.
  nombre           String?
  creadaEn         DateTime @default(now())
}

/**
 * Credencial de Google Drive del propio panel (ver ADR-0014) — no es por
 * Cuenta de Instagram, es una sola, del Drive del dueño del panel. `slot` con
 * unique fuerza que sólo pueda existir una fila; reconectar la pisa.
 */
model DriveCredencial {
  id                     String   @id @default(cuid())
  slot                   String   @unique @default("default")
  cuentaGoogleEmail      String
  refreshTokenEncriptado String
  creadaEn               DateTime @default(now())
  actualizadaEn          DateTime @updatedAt
}
